{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "components/home/maps.tsx", "components/home/Keunggulan.jsx", "app/layout.tsx", "components/home/HomeVideo.tsx", "components/home/SplitStickyHome.jsx", "components/admin/kontak/AdminKontak.tsx", "components/admin/informasi/publikasi/publikasiAdmin.tsx", "components/admin/pendaftaran/AdminPendaftaran.tsx", "components/home/jam.tsx", "components/home/about.jsx"  ],
  "exclude": ["node_modules"]
}
